{
  "name": "frontline",
  "version": "0.2.0",
  "description": "Frontline — browser tactical shooter with an authoritative Node server",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test test/*.test.js",
    "nettest": "node tools/nettest.js",
    "loadtest": "node tools/loadtest.js",
    "qa": "node qa/screens.js"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
